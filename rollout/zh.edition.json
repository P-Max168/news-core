{
 "edition": {
  "picker": "base_add",
  "pool": 40,
  "select": 25,
  "claim": true,
  "deploy": "pages",
  "live_check": "pages",
  "video_feed": false,
  "candidates_from": "kr",
  "after_deploy_cmd": "python3 ops/zh1_mirror.py run {eid} --backfill 3 && git add zh1 ops/gemini-usage.jsonl && (git diff --cached --quiet || git commit -q -m 'zh1: {eid} 한국어 검수 미러') && git pull --rebase --autostash -q origin main && git push -q origin HEAD:main",
  "cand_max_age_min": 60,
  "grok_add": {
   "max": 4,
   "sources": [
    "https://raw.githubusercontent.com/P-Max168/thai-news-kr/main/tools/sources.json",
    "tools/sources.zh.json"
   ],
   "cutoff": {
    "am": [
     7,
     45
    ],
    "md": [
     12,
     45
    ],
    "pm": [
     18,
     45
    ]
   }
  },
  "_picker_rollback": "되돌리기: picker 를 grok_file 로",
  "cand_sources_url": "https://raw.githubusercontent.com/P-Max168/thai-news-kr/main/tools/sources.json"
 },
 "side": {
  "cmds": [
   "python3 tools/fetch_china.py --standalone {force}",
   "python3 tools/fetch_ticker.py"
  ],
  "files": [
   "data/china.json",
   "data/china.js",
   "data/ticker.json",
   "data/ticker.js"
  ],
  "label": "china: 中国要闻·시세",
  "pip": [
   "googlenewsdecoder"
  ]
 }
}
